<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/fondo_claro"
    android:padding="24dp"

    tools:context=".LoginActivity">


    <!-- ============================================== -->
    <!-- LOGO -->
    <!-- ============================================== -->

    <TextView
        android:id="@+id/tvLogo"

        android:layout_width="70dp"
        android:layout_height="70dp"

        android:layout_marginTop="55dp"

        android:background="@drawable/bg_logo"

        android:gravity="center"

        android:text="M"
        android:textColor="@color/blanco"
        android:textSize="32sp"
        android:textStyle="bold"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <!-- ============================================== -->
    <!-- TÍTULO -->
    <!-- ============================================== -->

    <TextView
        android:id="@+id/tvTitulo"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="16dp"

        android:text="ModaApp"
        android:textColor="@color/rosa_principal"
        android:textSize="30sp"
        android:textStyle="bold"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLogo" />


    <!-- ============================================== -->
    <!-- SUBTÍTULO -->
    <!-- ============================================== -->

    <TextView
        android:id="@+id/tvSubtitulo"

        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="4dp"

        android:text="Boutique Moda Urbana"
        android:textColor="@color/texto_secundario"
        android:textSize="15sp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitulo" />


    <!-- ============================================== -->
    <!-- USUARIO -->
    <!-- ============================================== -->

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilUsuario"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="40dp"

        android:hint="Usuario"

        app:boxBackgroundMode="outline"
        app:boxStrokeColor="@color/rosa_principal"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitulo">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etUsuario"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:inputType="text"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>


    <!-- ============================================== -->
    <!-- CONTRASEÑA -->
    <!-- ============================================== -->

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilContrasena"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="16dp"

        android:hint="Contraseña"

        app:boxBackgroundMode="outline"
        app:boxStrokeColor="@color/rosa_principal"

        app:endIconMode="password_toggle"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tilUsuario">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etContrasena"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:inputType="textPassword"
            android:maxLines="1" />

    </com.google.android.material.textfield.TextInputLayout>


    <!-- ============================================== -->
    <!-- INFORMACIÓN DE ACCESO -->
    <!-- ============================================== -->

    <TextView
        android:id="@+id/tvInfoAcceso"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="12dp"

        android:gravity="center"

        android:text="Acceso administrador: admin / 1234&#10;Para realizar un pedido, ingresa a Ver catálogo."
        android:textColor="@color/texto_secundario"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tilContrasena" />


    <!-- ============================================== -->
    <!-- INGRESAR -->
    <!-- ============================================== -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnIngresar"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="18dp"

        android:text="Ingresar como administrador"
        android:textAllCaps="false"
        android:textColor="@color/blanco"
        android:textSize="15sp"

        app:backgroundTint="@color/rosa_principal"
        app:cornerRadius="12dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvInfoAcceso" />


    <!-- ============================================== -->
    <!-- VER CATÁLOGO -->
    <!-- ============================================== -->

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCatalogo"

        android:layout_width="0dp"
        android:layout_height="wrap_content"

        android:layout_marginTop="12dp"

        android:text="Ver catálogo"
        android:textAllCaps="false"
        android:textColor="@color/rosa_principal"
        android:textSize="15sp"

        app:backgroundTint="@color/blanco"

        app:strokeColor="@color/rosa_principal"
        app:strokeWidth="2dp"

        app:cornerRadius="12dp"

        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnIngresar" />


</androidx.constraintlayout.widget.ConstraintLayout>