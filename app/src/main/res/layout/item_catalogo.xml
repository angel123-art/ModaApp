<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginBottom="12dp"

    app:cardCornerRadius="14dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:padding="18dp">

        <TextView
            android:id="@+id/tvNombreCatalogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Polo básico"
            android:textColor="@color/rosa_principal"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCategoriaCatalogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="5dp"

            android:text="Polos"
            android:textColor="@color/texto_secundario" />

        <TextView
            android:id="@+id/tvDetallesCatalogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:text="Talla: M | Color: Negro"
            android:textColor="@color/texto_principal" />

        <TextView
            android:id="@+id/tvPrecioCatalogo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:text="S/ 49.90"
            android:textColor="@color/rosa_principal"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>