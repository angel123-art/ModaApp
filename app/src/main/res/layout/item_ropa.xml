<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginBottom="10dp"

    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvNombreRopa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Polo básico"
            android:textColor="@color/rosa_principal"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvCodigoRopa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:text="Código: R001"
            android:textColor="@color/texto_secundario"/>

        <TextView
            android:id="@+id/tvDetallesRopa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"

            android:text="M | Negro | Polos"
            android:textColor="@color/texto_principal"/>

        <TextView
            android:id="@+id/tvPrecioStock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:text="S/ 59.90 | Stock: 10"
            android:textColor="@color/rosa_principal"
            android:textStyle="bold"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>