<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:layout_marginBottom="10dp"

    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvNombreCarrito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Polo básico"
            android:textColor="@color/rosa_principal"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCantidadCarrito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="5dp"

            android:text="Cantidad: 2"
            android:textColor="@color/texto_principal" />

        <TextView
            android:id="@+id/tvPrecioCarrito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="5dp"

            android:text="Precio: S/ 49.90"
            android:textColor="@color/texto_secundario" />

        <TextView
            android:id="@+id/tvSubtotalCarrito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="5dp"

            android:text="Subtotal: S/ 99.80"
            android:textColor="@color/rosa_principal"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEliminarCarrito"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="5dp"

            android:text="Eliminar"
            android:textAllCaps="false"
            android:textColor="@color/rosa_principal"

            app:backgroundTint="@color/blanco"
            app:strokeColor="@color/rosa_principal"
            app:strokeWidth="1dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>